@startuml
!include ./plantuml-style.iuml
hide footbox

actor Alice
database MeisterChartsBuilder #3b9181
participant ChartSupport #9fd5d8
participant WindowSizeBindingStrategy<<ImmediateWindowSizeBindingStrategy>> #00a1e5
participant ChartState #c5e5eb
participant ContentAreaSizingStrategy<<BindContentArea2WindowSize>> #9fd5d8
participant ResizeBehavior<<KeepCenterOnResize>>
participant ZoomAndTranslationSupport
participant ZoomAndTranslationDefaults<<noTranslation>>


== Initialization ==

Alice -> MeisterChartsBuilder: build()
MeisterChartsBuilder -> ChartSupport:initialize()
ChartSupport -> ContentAreaSizingStrategy:bindResize(this)

ContentAreaSizingStrategy -> ContentAreaSizingStrategy:calculateContentAreaSize -> (0/0)
ContentAreaSizingStrategy -> ResizeBehavior:handleResize(contentAreaSize=0/0, windowSize=0/0)

ResizeBehavior -> ZoomAndTranslationSupport:resetToDefaults()
activate ZoomAndTranslationSupport #55beeb

ZoomAndTranslationSupport  -> ZoomAndTranslationSupport:resetZoom()
activate ZoomAndTranslationSupport #002e46

  ZoomAndTranslationSupport -> ZoomAndTranslationDefaults:defaultZoom()
  activate ZoomAndTranslationDefaults
  return 1.0/1.0
  deactivate ZoomAndTranslationDefaults

  ZoomAndTranslationSupport  -> ZoomAndTranslationSupport:setZoom(1.0/1.0)

deactivate ZoomAndTranslationSupport


ZoomAndTranslationSupport -> ZoomAndTranslationSupport:resetWindowTranslation()
activate ZoomAndTranslationSupport #002e46

ZoomAndTranslationSupport -> ZoomAndTranslationDefaults:defaultTranslation()
activate ZoomAndTranslationDefaults
return 0.0/0.0
deactivate ZoomAndTranslationDefaults
ZoomAndTranslationSupport -> ZoomAndTranslationSupport:setWindowTranslation(0.0/0.0)

deactivate ZoomAndTranslationSupport
deactivate ZoomAndTranslationSupport

== Window Resize ==

Alice -> WindowSizeBindingStrategy:Change Window Size (800/600)
WindowSizeBindingStrategy -> ChartState:windowSize=800/600
ChartState -> ContentAreaSizingStrategy:windowSizeProperty changed

ContentAreaSizingStrategy -> ContentAreaSizingStrategy:calculateContentAreaSize -> 800/600
ContentAreaSizingStrategy -> ResizeBehavior:handleResize(800/600, 800/600)

ResizeBehavior -> ZoomAndTranslationSupport:resetToDefaults() [...]

...see above...

== Reset Gesture (Double Click) ==

Alice -> ZoomAndTranslationLayer: Double Click
ZoomAndTranslationLayer -> ZoomAndTranslationSupport:resetToDefaults()

...see above...


'TextService -> SimpleTextResolver: translate(TextKey, Locale)
'return String?
'TextService -> MapBasedTextResolver: translate(TextKey, Locale)
'return String?
'TextService -> FallbackLocaleTextResolver: translate(TextKey, Locale)
'
'FallbackLocaleTextResolver -> MapBasedTextResolver : translate(TextKey, Default-Locale)
'return String?
'FallbackLocaleTextResolver --> TextService: String?
'
'TextService -> DefaultTextResolver: translate(TextKey, Locale)
'return String?
'
'TextService --> Alice: String?

@enduml


